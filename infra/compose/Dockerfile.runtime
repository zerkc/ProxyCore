# syntax=docker/dockerfile:1.10
# Supported platforms: linux/amd64 and linux/arm64 only (Bun publishes no
# arm/v7 or 386 builds). Dependencies are installed on BUILDPLATFORM so the
# arm64 image never runs `bun install` under QEMU; this relies on the runtime
# dependencies being pure JavaScript (no per-platform native addons).
FROM --platform=$BUILDPLATFORM oven/bun:1.3.14-alpine AS deps

WORKDIR /app

# Lockfile and workspace markers first — these rarely change. apps/ui/package.json
# is needed so --filter '!@proxycore/ui' can resolve the workspace name.
COPY package.json bun.lock bunfig.toml tsconfig.json ./
COPY apps/ui/package.json ./apps/ui/package.json
COPY packages ./packages

# Install with cache mount — repeat builds skip redownloading deps entirely.
# Source is NOT copied yet, so source changes won't bust this layer.
RUN --mount=type=cache,id=bun-runtime,target=/root/.bun/install/cache \
    bun install --frozen-lockfile --production --filter '!@proxycore/ui'

# Go worker (apps/api/cmd/worker). The compose `worker` service on existing
# installs still runs `bun run worker` from the host compose.yaml, which the
# dashboard update never rewrites, so the Go binary ships inside this image and
# the `worker` script below execs it. Static binary (CGO_ENABLED=0): it
# cross-compiles on BUILDPLATFORM for TARGETOS/TARGETARCH, no QEMU.
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS worker-build
ARG TARGETOS
ARG TARGETARCH
ARG TARGETVARIANT
WORKDIR /src

COPY apps/api/go.mod apps/api/go.sum ./
RUN --mount=type=cache,id=go-mod,target=/go/pkg/mod \
    go mod download

COPY apps/api/ ./

# GOMAXPROCS/GOGC cap the compiler's CPU and heap use on small (1 GB) nodes.
ENV GOMAXPROCS=2 GOGC=50
RUN --mount=type=cache,id=go-mod,target=/go/pkg/mod \
    --mount=type=cache,id=go-build,target=/root/.cache/go-build \
    if [ "${TARGETARCH}" = arm ]; then export GOARM="${TARGETVARIANT#v}"; fi \
    && CGO_ENABLED=0 GOOS="${TARGETOS:-linux}" GOARCH="${TARGETARCH:-$(go env GOARCH)}" go build -trimpath \
       -ldflags="-s -w" -o /out/proxycore-worker ./cmd/worker

# Go control (apps/api/cmd/control), shipped the same way for the same reason:
# existing installs run `bun run control` from their unrefreshed host
# compose.yaml. Reuses the worker-build stage (same module download and
# GOMAXPROCS/GOGC settings) so the module cache is hot.
FROM worker-build AS control-build
ARG TARGETOS
ARG TARGETARCH
ARG TARGETVARIANT
RUN --mount=type=cache,id=go-mod,target=/go/pkg/mod \
    --mount=type=cache,id=go-build,target=/root/.cache/go-build \
    if [ "${TARGETARCH}" = arm ]; then export GOARM="${TARGETVARIANT#v}"; fi \
    && CGO_ENABLED=0 GOOS="${TARGETOS:-linux}" GOARCH="${TARGETARCH:-$(go env GOARCH)}" go build -trimpath \
       -ldflags="-s -w" -o /out/proxycore-control ./cmd/control

FROM oven/bun:1.3.14-alpine

WORKDIR /app

COPY package.json bun.lock bunfig.toml tsconfig.json ./
COPY apps/ui/package.json ./apps/ui/package.json
COPY packages ./packages
COPY --from=deps /app/node_modules ./node_modules

# Source last — changes here only invalidate layers below this point.
COPY apps/worker ./apps/worker
COPY apps/control ./apps/control

COPY --from=worker-build /out/proxycore-worker /usr/local/bin/proxycore-worker
COPY --from=control-build /out/proxycore-control /usr/local/bin/proxycore-control

# `bun run worker` / `bun run control` exec the Go binaries.
# PROXYCORE_WORKER_IMPL=bun and PROXYCORE_CONTROL_IMPL=bun are the rollback
# switches to the TypeScript processes (source kept for this release). Every
# branch uses `exec` so SIGTERM from `docker stop` reaches the process itself.
# Only this image's /app/package.json is rewritten, never the repo's.
RUN bun -e 'const f="package.json";const p=await Bun.file(f).json();p.scripts.worker="if [ \"$PROXYCORE_WORKER_IMPL\" = bun ]; then exec bun run apps/worker/src/index.ts; fi; exec /usr/local/bin/proxycore-worker";p.scripts.control="if [ \"$PROXYCORE_CONTROL_IMPL\" = bun ]; then exec bun run apps/control/src/index.ts; fi; exec /usr/local/bin/proxycore-control";await Bun.write(f,JSON.stringify(p,null,2)+"\n")' \
    && bun -e 'const s=(await Bun.file("package.json").json()).scripts;console.log(s.worker);console.log(s.control)' \
    && test -x /usr/local/bin/proxycore-worker && test -x /usr/local/bin/proxycore-control

# Default process; compose overrides it per service (worker / control).
CMD ["bun", "run", "worker"]
