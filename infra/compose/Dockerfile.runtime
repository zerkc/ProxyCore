# syntax=docker/dockerfile:1.10
# Runtime image shared by the compose `worker` and `control` services. It holds
# two static Go binaries on plain Alpine; there is no Bun, Node or TypeScript.
# Supported platforms: linux/amd64, linux/arm64 and linux/arm/v7. Both Go
# stages run on BUILDPLATFORM and cross-compile (CGO_ENABLED=0), so QEMU is
# never needed for the compile.

# Go worker (apps/api/cmd/worker). Static binary (CGO_ENABLED=0): it
# cross-compiles on BUILDPLATFORM for TARGETOS/TARGETARCH, no QEMU.
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS worker-build
ARG TARGETOS
ARG TARGETARCH
ARG TARGETVARIANT
WORKDIR /src

COPY apps/api/go.mod apps/api/go.sum ./
RUN --mount=type=cache,id=go-mod,target=/go/pkg/mod \
    go mod download

COPY apps/api/ ./

# GOMAXPROCS/GOGC cap the compiler's CPU and heap use on small (1 GB) nodes.
ENV GOMAXPROCS=2 GOGC=50
RUN --mount=type=cache,id=go-mod,target=/go/pkg/mod \
    --mount=type=cache,id=go-build,target=/root/.cache/go-build \
    if [ "${TARGETARCH}" = arm ]; then export GOARM="${TARGETVARIANT#v}"; fi \
    && CGO_ENABLED=0 GOOS="${TARGETOS:-linux}" GOARCH="${TARGETARCH:-$(go env GOARCH)}" go build -trimpath \
       -ldflags="-s -w" -o /out/proxycore-worker ./cmd/worker

# Go control (apps/api/cmd/control), built the same way. Reuses the
# worker-build stage (same module download and GOMAXPROCS/GOGC settings) so the
# module cache is hot.
FROM worker-build AS control-build
ARG TARGETOS
ARG TARGETARCH
ARG TARGETVARIANT
RUN --mount=type=cache,id=go-mod,target=/go/pkg/mod \
    --mount=type=cache,id=go-build,target=/root/.cache/go-build \
    if [ "${TARGETARCH}" = arm ]; then export GOARM="${TARGETVARIANT#v}"; fi \
    && CGO_ENABLED=0 GOOS="${TARGETOS:-linux}" GOARCH="${TARGETARCH:-$(go env GOARCH)}" go build -trimpath \
       -ldflags="-s -w" -o /out/proxycore-control ./cmd/control

# Runtime: busybox `sh`, `test`, `stat` and `date` (compose healthchecks) plus
# the two binaries. Runs as root like the previous image: the worker writes
# candidates the nginx and coredns containers read, and control needs the
# Docker socket and owns the control socket directory.
FROM alpine:3.22
WORKDIR /app
RUN mkdir -p /run/proxycore /var/lib/proxycore/candidates

COPY --from=worker-build /out/proxycore-worker /usr/local/bin/proxycore-worker
COPY --from=control-build /out/proxycore-control /usr/local/bin/proxycore-control

# Backward compatibility only: host compose.yaml files written by older
# installers still run `bun run worker` / `bun run control` and are never
# refreshed by dashboard updates. The script is not Bun; see its header.
COPY infra/compose/bun-compat.sh /usr/local/bin/bun
RUN chmod 0755 /usr/local/bin/bun \
    && test -x /usr/local/bin/proxycore-worker \
    && test -x /usr/local/bin/proxycore-control

# Default process; compose overrides it for control. Nothing here uses the shim.
CMD ["/usr/local/bin/proxycore-worker"]
