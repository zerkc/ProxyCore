# Transitional configuration API (Bun). No Next.js dependency.
FROM oven/bun:1.3.14-alpine
WORKDIR /app
COPY package.json bun.lock bunfig.toml tsconfig.json ./
COPY apps/ui/package.json ./apps/ui/package.json
COPY packages ./packages
COPY apps/web ./apps/web
COPY drizzle.config.ts ./
RUN bun install --frozen-lockfile --production --filter '!@proxycore/ui'
ENV NODE_ENV=production
ENV PROXYCORE_RUNTIME=container
ENV PROXYCORE_NODE_API_PORT=3001
EXPOSE 3001
CMD ["bun", "run", "apps/web/src/standalone.ts"]
