# syntax=docker/dockerfile:1.10

# UI build (Vite). Kept as a separate stage so the API runtime only inherits
# the built dist. Cache mounts make repeat builds skip reinstall + transpile.
FROM oven/bun:1.3.14-alpine AS ui
WORKDIR /ui

# Install the UI's deps. No --frozen-lockfile here because the lockfile lives
# in the workspace root and references other workspaces; only the UI's
# package.json is needed to resolve its own deps. The cache mount lets repeat
# builds skip redownloading entirely.
COPY apps/ui/package.json ./
RUN --mount=type=cache,id=bun-ui,target=/root/.bun/install/cache \
    bun install

# Source copy happens AFTER install so source changes don't bust the install
# layer. Vite cache mount lets esbuild prebundle cache survive across runs.
COPY apps/ui/index.html apps/ui/vite.config.ts apps/ui/tsconfig.json apps/ui/tsconfig.node.json ./
COPY apps/ui/src ./src
RUN --mount=type=cache,id=vite,target=/ui/node_modules/.vite \
    bun run build

# Go API. Split into two layers: deps (cached when go.mod/go.sum unchanged)
# and build (cached when source unchanged thanks to the go-build cache mount).
FROM golang:1.25-alpine AS api
WORKDIR /src

# Layer 1: dependencies only.
COPY apps/api/go.mod apps/api/go.sum ./
RUN --mount=type=cache,id=go-mod,target=/go/pkg/mod \
    go mod download

# Layer 2: source. VERSION is embedded via -ldflags, so it sits next to source.
COPY VERSION ./VERSION
COPY apps/api/ ./

# Layer 3: build. Cache mounts persist compiled objects between runs.
RUN --mount=type=cache,id=go-mod,target=/go/pkg/mod \
    --mount=type=cache,id=go-build,target=/root/.cache/go-build \
    VERSION="$(tr -d '[:space:]' < VERSION)" \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath \
       -ldflags="-s -w -X github.com/zerkc/ProxyCore/apps/api/internal/version.Version=${VERSION}" \
       -o /out/proxycore-api ./cmd/server

# Runtime: single static binary + SPA assets.
FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata wget \
  && adduser -D -H -u 10001 proxycore
WORKDIR /app
COPY --from=api /out/proxycore-api /app/proxycore-api
COPY --from=ui /ui/dist /app/ui
ENV PROXYCORE_UI_DIST=/app/ui
ENV PROXYCORE_API_ADDR=:3000
USER proxycore
EXPOSE 3000
ENTRYPOINT ["/app/proxycore-api"]
