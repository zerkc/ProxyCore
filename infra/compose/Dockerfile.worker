# syntax=docker/dockerfile:1.10

# Go worker (apps/api/cmd/worker): the pure-Go replacement for the Bun worker.
# Published as proxycore-worker but not referenced by compose.yaml until the
# cutover. The binary is static (CGO_ENABLED=0), so it cross-compiles natively
# on BUILDPLATFORM for TARGETOS/TARGETARCH (no QEMU), including linux/arm/v7.
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS build
ARG TARGETOS
ARG TARGETARCH
ARG TARGETVARIANT
WORKDIR /src

# Layer 1: dependencies only.
COPY apps/api/go.mod apps/api/go.sum ./
RUN --mount=type=cache,id=go-mod,target=/go/pkg/mod \
    go mod download

# Layer 2: source.
COPY apps/api/ ./

# Layer 3: build. Cache mounts persist compiled objects between runs.
# GOMAXPROCS/GOGC cap the compiler's CPU and heap use on small (1 GB) nodes.
ENV GOMAXPROCS=2 GOGC=50
RUN --mount=type=cache,id=go-mod,target=/go/pkg/mod \
    --mount=type=cache,id=go-build,target=/root/.cache/go-build \
    if [ "${TARGETARCH}" = arm ]; then export GOARM="${TARGETVARIANT#v}"; fi \
    && CGO_ENABLED=0 GOOS="${TARGETOS:-linux}" GOARCH="${TARGETARCH:-$(go env GOARCH)}" go build -trimpath \
       -ldflags="-s -w" -o /out/proxycore-worker ./cmd/worker

# Runtime: one static binary. The compose healthcheck runs `sh`, `test`, `stat`
# and `date` against the heartbeat file, all provided by busybox. Like the Bun
# worker it runs as root: it writes candidates the nginx and coredns containers
# read, and talks to the control socket owned by the control service.
FROM alpine:3.22
RUN mkdir -p /run/proxycore /var/lib/proxycore/candidates
COPY --from=build /out/proxycore-worker /usr/local/bin/proxycore-worker
ENTRYPOINT ["/usr/local/bin/proxycore-worker"]
