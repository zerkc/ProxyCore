# Compose / production. For local pnpm: cp .env.example.dev .env
#
# With scripts/install.sh these are generated automatically on first run:
#   PROXYCORE_MASTER_KEY_BASE64  (openssl rand -base64 32)
#   POSTGRES_PASSWORD            (random)
#   POSTGRES_DB / POSTGRES_USER  (proxycore)
# Manual copy of this file: set the master key and change the password yourself.

PROXYCORE_MASTER_KEY_BASE64=
POSTGRES_DB=proxycore
POSTGRES_USER=proxycore
POSTGRES_PASSWORD=change-me

WEB_PORT=3000
DNS_PORT=53

# Session cookies: leave unset/0 for HTTP (LAN IP). Set 1 only behind HTTPS.
# PROXYCORE_SECURE_COOKIES=0

# Optional: address CoreDNS returns for proxied names.
# Leave blank to auto-detect / initialize from the dashboard LAN URL.
PROXY_INGRESS_IPV4=
PROXY_INGRESS_IPV6=

# ACME (staging by default; use production directory for real certs)
ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_PRODUCTION_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
# Optional contact email for Let's Encrypt account registration / renewal
PROXYCORE_ACME_EMAIL=
# How often the API scans for due Let's Encrypt renewals (Go duration, default 1h)
PROXYCORE_CERT_RENEWAL_INTERVAL=1h

# Check GitHub for a newer stable ProxyCore release (set 0 to disable)
PROXYCORE_UPDATE_CHECK_ENABLED=1
# Minimum time between GitHub checks (Go duration, default 6h)
PROXYCORE_UPDATE_CHECK_INTERVAL=6h
# Maximum time allowed for each GitHub request (Go duration, default 5s)
PROXYCORE_UPDATE_CHECK_TIMEOUT=5s

# Host-network nginx → published web port (change if WEB_PORT changes)
NGINX_ACME_UPSTREAM=http://127.0.0.1:3000
