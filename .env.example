NODE_ENV=development
DATABASE_URL=postgres://proxycore:proxycore@localhost:5432/proxycore
PROXYCORE_PERSISTENCE_MODE=memory
PROXYCORE_MASTER_KEY_BASE64=
SESSION_COOKIE_NAME=proxycore_session
SESSION_TTL_SECONDS=28800
# Optional overrides for the address CoreDNS returns for proxied names.
# Leave blank to auto-detect a native LAN address or initialize from the
# literal LAN address used to access the Compose dashboard.
PROXY_INGRESS_IPV4=
PROXY_INGRESS_IPV6=
WORKER_SOCKET_PATH=/run/proxycore/control.sock
WORKER_RECONCILIATION_INTERVAL_MS=300000
WORKER_JOB_LEASE_MS=120000
WORKER_CANDIDATE_ROOT=/var/lib/proxycore/candidates
CONTROL_BACKEND=fixed
CANDIDATE_ROOT=/var/lib/proxycore/candidates
NGINX_CONTAINER_NAME=proxycore-nginx
COREDNS_CONTAINER_NAME=proxycore-coredns
CORE_DNS_CONFIG_DIR=/var/lib/proxycore/coredns
NGINX_CONFIG_DIR=/var/lib/proxycore/nginx
# Compose publishes these for the data plane. For proxy smoke tests the
# demo-upstream service is fixed at 172.30.0.10:80 on the data network.
WEB_PORT=3000
# Published only for CoreDNS; nginx uses network_mode: host.
DNS_PORT=53
# Host-network nginx reaches the control plane on the published web port.
NGINX_ACME_UPSTREAM=http://127.0.0.1:3000
NGINX_NETWORK_MODE=host
ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_PRODUCTION_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
POSTGRES_DB=proxycore
POSTGRES_USER=proxycore
POSTGRES_PASSWORD=change-me
