# Local development (pnpm next / worker / control outside Compose).
# Copy to .env: cp .env.example.dev .env

NODE_ENV=development
DATABASE_URL=postgres://proxycore:proxycore@localhost:5432/proxycore

# memory = in-process store (no Postgres). postgres = use DATABASE_URL.
PROXYCORE_PERSISTENCE_MODE=memory

# Dev-only placeholder (32 zero bytes, base64). Replace for anything beyond local UI.
PROXYCORE_MASTER_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

SESSION_COOKIE_NAME=proxycore_session
SESSION_TTL_SECONDS=28800

# Optional advertised ingress; blank → auto-detect on native host.
PROXY_INGRESS_IPV4=
PROXY_INGRESS_IPV6=

WORKER_SOCKET_PATH=/tmp/proxycore/control.sock
WORKER_RECONCILIATION_INTERVAL_MS=300000
WORKER_JOB_LEASE_MS=120000
WORKER_CANDIDATE_ROOT=/tmp/proxycore/candidates
WORKER_HEARTBEAT_PATH=/tmp/proxycore/worker.heartbeat

# fixed = no Docker reload; docker = talk to named Compose containers.
CONTROL_BACKEND=fixed
CANDIDATE_ROOT=/tmp/proxycore/candidates
NGINX_CONTAINER_NAME=proxycore-nginx
COREDNS_CONTAINER_NAME=proxycore-coredns
CORE_DNS_CONFIG_DIR=/tmp/proxycore/coredns
NGINX_CONFIG_DIR=/tmp/proxycore/nginx
NGINX_ACME_UPSTREAM=http://127.0.0.1:3000

ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_PRODUCTION_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
# Cloudflare DNS-01 credentials are entered in the Certificates UI (encrypted at rest).
