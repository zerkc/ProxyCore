{
  "name": "proxycore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single-installation homelab DNS and ingress control plane",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.16.0"
  },
  "scripts": {
    "dev": "next dev apps/web",
    "build": "next build apps/web",
    "start": "next start apps/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint eslint.config.mjs apps/web/postcss.config.mjs",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "control": "tsx apps/control/src/index.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "acme-client": "^5.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "selfsigned": "^5.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.10",
    "vitest": "^4.1.10"
  }
}
