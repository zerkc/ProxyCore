{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@proxycore/domain": ["./packages/domain/src/index.ts"],
      "@proxycore/domain/*": ["./packages/domain/src/*"],
      "@proxycore/db": ["./packages/db/src/index.ts"],
      "@proxycore/db/*": ["./packages/db/src/*"],
      "@proxycore/config": ["./packages/config/src/index.ts"],
      "@proxycore/config/*": ["./packages/config/src/*"],
      "@proxycore/crypto": ["./packages/crypto/src/index.ts"],
      "@proxycore/crypto/*": ["./packages/crypto/src/*"],
      "@proxycore/renderers": ["./packages/renderers/src/index.ts"],
      "@proxycore/renderers/*": ["./packages/renderers/src/*"],
      "@proxycore/certificates": ["./packages/certificates/src/index.ts"],
      "@proxycore/certificates/*": ["./packages/certificates/src/*"],
      "@proxycore/testing": ["./packages/testing/src/index.ts"],
      "@proxycore/testing/*": ["./packages/testing/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
