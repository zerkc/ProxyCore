          { "kind": "exact", "pattern": "/old", "action": { "type": "redirect", "status": 301, "location": "https://example.com/new path" } },
          { "kind": "exact", "pattern": "/bare", "action": { "type": "redirect", "status": 302 } }
        ]
      }
    },
