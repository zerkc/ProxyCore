        "nginxDirectives": "# comment\r\nproxy_connect_timeout 3s; # trailing\r\nadd_header X-A b;\r\n"
      }
    },
    {
      "id": "a",
      "name": "alpha.home.arpa",
      "type": "A",
      "value": "192.168.1.22",
