      "type": "A",
      "value": "192.168.1.21",
      "ttl": 300,
      "enabled": true,
      "proxied": true,
      "proxy": {
        "origin": { "ip": "fd00::20", "port": 9000, "protocol": "http" },
        "tlsEnabled": false,
        "websocket": true,
        "cache": { "enabled": false },
        "timeouts": { "connectSeconds": 7, "sendReadSeconds": 120, "clientHeaderSeconds": 20, "bodyLimitMb": 50 },
