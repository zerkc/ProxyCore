      "enabled": true,
      "proxied": true,
      "proxy": {
        "origin": { "ip": "10.0.0.50", "port": 8443, "protocol": "https" },
        "tlsEnabled": true,
        "certificateId": "cert-alpha",
        "http3": true,
        "http2": false,
        "backendTlsVerify": true,
        "redirectHttpToHttps": false,
        "cache": { "enabled": true },
